# Database. Leave empty to use the built-in Postgres (PGlite) stored in ./data/pg.
# In production, a Postgres URL from Neon, Supabase or any host.
DATABASE_URL=

# AI. Leave empty for demo mode (keyword rules and fixed lines).
#   gemini    -> Gemini Flash Lite (needs GEMINI_API_KEY)
#   anthropic -> Claude (needs ANTHROPIC_API_KEY)
LLM_PROVIDER=
GEMINI_API_KEY=
# In a Claude Code cloud session, use APP_ANTHROPIC_API_KEY so it doesn't clash with Claude Code's own key.
ANTHROPIC_API_KEY=
# Optional model override. Defaults: gemini-3.1-flash-lite, claude-opus-5-5
LLM_MODEL=

# WhatsApp through Kapso. With a key, the server checks connected numbers for new messages every 3s.
KAPSO_API_KEY=
# Or, when the key is a network secret the cloud environment adds for api.kapso.ai:
KAPSO_ENABLED=
# Set to 0 to turn the WhatsApp check off (local polling).
KAPSO_POLL=
# The app's public address. On Vercel it's detected automatically. With it, Settings -> WhatsApp -> Connect
# registers a Kapso webhook (https://<APP_URL>/api/kapso/webhook) instead of polling.
APP_URL=

# Alerts to the owner (Settings → Alerts). Without a template, alerts are plain messages (24-hour rule).
# ALERT_TEMPLATE=needs_person
# ALERT_PHONE_NUMBER_ID=

# Who pays Meta for numbers owners connect themselves: customer_managed (the owner, default) or partner_managed (Kapso credits).
# KAPSO_META_BILLING=customer_managed
