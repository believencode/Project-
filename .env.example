# Database. Leave empty to use the built-in Postgres (PGlite) stored in ./data/pg.
# In production, a Postgres URL from Neon, Supabase or any host.
DATABASE_URL=

# AI. Leave empty for demo mode (keyword rules and fixed lines).
#   gemini    -> Gemini Flash Lite (needs GEMINI_API_KEY)
#   anthropic -> Claude (needs ANTHROPIC_API_KEY)
LLM_PROVIDER=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Optional model override. Defaults: gemini-3.1-flash-lite, claude-opus-5-5
LLM_MODEL=

# WhatsApp through Kapso. With a key, the server checks connected numbers for new messages every 3s.
KAPSO_API_KEY=
# Set to 0 to turn the WhatsApp check off.
KAPSO_POLL=
